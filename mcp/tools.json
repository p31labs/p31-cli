        "type": "object",
        "properties": { "level": { "type": "number" } }
      }
    },
    {
      "name": "phos_theme",
      "description": "Get or set PHOS theme",
      "category": "phos",
      "inputSchema": {
        "type": "object",
        "properties": {
          "theme": { "type": "string", "enum": ["quantum", "bridge", "sanctuary"] }
        }
      }
    },
    {
      "name": "system_health",
      "description": "Check system health",
      "category": "system"
    },
    {
      "name": "system_version",
      "description": "Get system version information",
      "category": "system"
    }
  ]
